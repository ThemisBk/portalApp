<h1>Create a New Post</h1>

<%= form_with model: @post do |f| %>
  <div style="margin-bottom: 15px;">
    <%= f.label :content, "What's on your mind?" %><br>
    <%= f.text_area :content, rows: 6, style: "width: 100%; padding: 10px; font-size: 16px;", placeholder: "Anyone want to study together?" %>
  </div>
  
  <%= f.submit "Publish Post", style: "background: blue; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;" %>
<% end %>

<div style="margin-top: 20px;">
  <%= link_to "← Back to Posts", posts_path %>
</div>
