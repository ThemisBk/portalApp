<!DOCTYPE html>
<html>
  <head>
    <title>PortalApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div style="padding: 10px; background-color: #f0f0f0; margin-bottom: 20px;">
      <% if user_signed_in? %>
        <span>Logged in as: <strong><%= current_user.email %></strong></span>
        <%= link_to "Edit Profile", edit_user_registration_path %> |
        <%= link_to "Posts", posts_path %> |        
        <%= link_to "Find Friends", users_path %> |
        <%= button_to "Logout", destroy_user_session_path, method: :delete, form: { style: 'display: inline;' }, style: 'background: none; border: none; color: blue; text-decoration: underline; cursor: pointer; padding: 0; font: inherit;' %>
      <% else %>
        <%= link_to "Sign Up", new_user_registration_path %> |
        <%= link_to "Login", new_user_session_path %>
      <% end %>
    </div>

    <p class="notice" style="color: green;"><%= notice %></p>
    <p class="alert" style="color: red;"><%= alert %></p>

    <%= yield %>
  </body>
</html>